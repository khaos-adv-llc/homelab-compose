# Template only -- Infisical itself is configured entirely via the Docker
# secrets files referenced in docker-compose.yml (./secrets/*.txt), not a
# .env file, to match the postgres pattern. Create these six files
# with real generated values before first start:
#
#   secrets/infisical_pg_user.txt
#   secrets/infisical_pg_pw.txt              (long random password)
#   secrets/infisical_encryption_key.txt     (openssl rand -hex 16)
#   secrets/infisical_auth_secret.txt        (openssl rand -base64 32)
#   secrets/infisical_db_uri.txt             (postgres://<user>:<pw>@infisical-db:5432/infisical)
#
# None of these ever get committed -- secrets/ is covered by the repo's
# .gitignore.
