# Template only -- lists the variable names this stack's docker-compose.yml
# expects. Real values live in Infisical, never here and never in git.
# scripts/render-env.sh writes the actual .env next to this file on the host.
#

# Password for Mealie's own dedicated `mealie-postgres` container, used
# both to configure that Postgres container itself (POSTGRES_PASSWORD) and
# by the mealie app container's DB connection settings to reach it. This
# is a plain env var here rather than a Docker secret -- this stack hasn't
# been migrated to file-based Docker secrets the way the central
# postgres/Authentik/Infisical stacks have.
MEALIE_DB_PASSWORD=REPLACE_ME

# --- Authentik OIDC login for Mealie ---
# Mealie is configured for OIDC login against Authentik at auth.valdeze.ch
# (OIDC_AUTH_ENABLED/OIDC_CONFIGURATION_URL etc. are hardcoded in
# docker-compose.yml), with these two values being the OIDC client
# credentials for Mealie's application registered in Authentik.
#
# NOTE: Mealie's traefik.* labels are deliberately commented out --
# confirmed by Tucker: Mealie is reached externally via Pangolin at
# meals.valdeze.ch, not through internal Traefik routing. Internal
# access via Traefik was tried and dropped as clunky for phone/computer
# app usage, so this isn't an oversight. BASE_URL in docker-compose.yml
# is hardcoded to https://meals.valdeze.ch to match.
MEALIE_OIDC_CLIENT_SECRET=REPLACE_ME
MEALIE_OIDC_CLIENT_ID=REPLACE_ME
