# Template only -- lists the variable names this stack's docker-compose.yml
# expects. Real values live in Infisical, never here and never in git.
# scripts/render-env.sh writes the actual .env next to this file on the host.
#

# Authentik API token for the `authentik-outpost` container defined
# alongside Traefik in this stack -- this is Authentik's forward-auth
# outpost, the fallback used to put OIDC-style auth in front of apps that
# can't speak OIDC natively themselves (as opposed to the LDAP outpost,
# which lives in the separate AuthentikOutpost stack). Generate this token
# in Authentik's admin UI when creating/assigning the outpost
# (Applications > Outposts).
#
# Note on this stack overall: Traefik itself needs zero ${VAR}
# substitution for its own config (its cert resolver, entrypoints, etc.
# all live in ./config/traefik.yml and ./dynamic/, not env vars) -- its
# Cloudflare DNS-01 API token is instead read via CF_DNS_API_TOKEN_FILE
# from ./secrets/cloudflare_dns_api_token, a plain bind-mounted file at the
# /run/secrets/ convention (not a native Compose `secrets:` top-level
# block like postgres/Authentik/Infisical use) -- either way, not from
# this .env. Traefik also
# reaches the Docker API through the `socket-proxy` container in this same
# stack rather than mounting /var/run/docker.sock directly -- reuse that
# pattern for anything new that needs Docker service discovery.
AUTHENTIK_OUTPOST_TOKEN=REPLACE_ME
