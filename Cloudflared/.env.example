# Template only -- lists the variable names this stack's docker-compose.yml
# expects. Real values live in Infisical, never here and never in git.
# scripts/render-env.sh writes the actual .env next to this file on the host.
#

# The Cloudflare Tunnel token for this container (from the Cloudflare Zero
# Trust dashboard, Networks > Tunnels). This is a SEPARATE mechanism from
# Traefik's Let's Encrypt certs (which use Cloudflare's DNS-01 API instead,
# over in the Traefik stack) -- don't confuse the two. This standalone
# `cloudflared` container tunnels traffic to Cloudflare directly, without
# going through Traefik or Pangolin/newt at all.
#
# Note the lowercase variable name (cloudflare_token) -- every other stack
# in this repo uses SCREAMING_SNAKE_CASE for its variables, so this is an
# inconsistency worth normalizing to CLOUDFLARE_TOKEN if this stack's
# docker-compose.yml is ever touched again (left as-is here since renaming
# it means updating docker-compose.yml too, which is out of scope for this
# comment pass).
cloudflare_token=REPLACE_ME
