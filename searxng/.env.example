# Template only -- lists the variable names this stack's docker-compose.yml
# expects. Real values live in Infisical, never here and never in git.
# scripts/render-env.sh writes the actual .env next to this file on the host.
#
# Read the documentation before using the `docker-compose.yml` file:
# https://docs.searxng.org/admin/installation-docker.html
#
# Additional ENVs:
# https://docs.searxng.org/admin/settings/settings_general.html#settings-general
# https://docs.searxng.org/admin/settings/settings_server.html#settings-server
#
# Unlike most stacks in this repo, none of these are secrets -- SearXNG (the
# self-hosted metasearch engine) doesn't have real credentials to manage
# here at all. These three are just optional deployment knobs, all
# commented out because the image's own defaults are already sane for this
# homelab. The `core` service also does `env_file: ./.env`, so anything you
# uncomment here (or add per SearXNG's own settings docs above) is passed
# straight into the container as an environment variable, on top of these
# three ${VAR}-with-default substitutions docker-compose.yml itself makes.
#
# Note: there are no traefik.* labels anywhere in this stack's compose
# file, so it's not clear from this repo alone how/whether searxng is
# currently reached at all (the ports: mapping below is also commented
# out) -- worth checking with Tucker rather than assuming a routing
# pattern.

# Use a specific version tag. E.g. "latest" or "2026.3.25-541c6c3cb".
# Leave commented to just track "latest".
#SEARXNG_VERSION=latest
# Listen to a specific address. Only matters if you uncomment the (currently
# disabled) ports: mapping below.
#SEARXNG_HOST=[::]
# Listen to a specific port -- same caveat as SEARXNG_HOST above.
#SEARXNG_PORT=8080
