# Template only -- lists the variable names this stack's docker-compose.yml
# expects. Real values live in Infisical, never here and never in git.
# scripts/render-env.sh writes the actual .env next to this file on the host.
#

# Cross-cutting value shared by several stacks in this repo -- normally
# set once as an Arcane "global Variable". Used by every container in this
# stack (homeassistant, matter-server, mosquitto, scrypted,
# music-assistant-server).
TZ=Europe/Zurich

# --- Home Assistant core ---
# HA_IMAGE/HA_TAG build the image reference (${HA_IMAGE}:${HA_TAG}), so you
# can pin a specific Home Assistant release instead of always tracking
# whatever "stable" points to. HA_CONTAINER_NAME sets the container's name
# (also used by `docker exec` if you need to touch config by hand -- see
# below). HA_PORT is the internal port the healthcheck probes
# (http://127.0.0.1:${HA_PORT}/manifest.json); HA normally listens on 8123.
#
# Reminder: this whole stack runs with network_mode: host (needed for
# HA, Matter, MQTT discovery, Scrypted and Music Assistant to do LAN
# device discovery properly), and ./homeassistant/config on the host is
# likely root-owned -- edit HA's config through `docker exec homeassistant
# ...` rather than editing those files directly from the host shell.
HA_IMAGE=REPLACE_ME
HA_TAG=REPLACE_ME
HA_CONTAINER_NAME=REPLACE_ME
HA_PORT=REPLACE_ME

# --- Matter server (python-matter-server) ---
# Bridges Matter/Thread smart-home devices into Home Assistant.
# MATTER_IMAGE/MATTER_TAG pin the image the same way as HA above.
# MATTER_CONTAINER_NAME names the container. MATTER_PORT is the port the
# matter-server process listens on (passed via --port). MATTER_BT_ADAPTER
# selects which host Bluetooth adapter to use for Matter commissioning
# (e.g. "hci0" -- only matters if you're commissioning devices over BLE).
# MATTER_LOG_LEVEL controls verbosity (e.g. info, debug).
MATTER_IMAGE=REPLACE_ME
MATTER_TAG=REPLACE_ME
MATTER_CONTAINER_NAME=REPLACE_ME
MATTER_PORT=REPLACE_ME
MATTER_BT_ADAPTER=REPLACE_ME
MATTER_LOG_LEVEL=REPLACE_ME

# --- Mosquitto (MQTT broker) ---
# MQTT_IMAGE/MQTT_TAG pin the Mosquitto image/version. MQTT_CONTAINER_NAME
# names the container. Mosquitto's actual broker config (listeners, auth,
# ACLs) lives in ./mosquitto/config on the host, not in env vars.
MQTT_IMAGE=REPLACE_ME
MQTT_TAG=REPLACE_ME
MQTT_CONTAINER_NAME=REPLACE_ME
