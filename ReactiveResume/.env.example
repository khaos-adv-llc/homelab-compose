# Template only -- lists the variable names this stack's docker-compose.yml
# expects. Real values live in Infisical, never here and never in git.
# scripts/render-env.sh writes the actual .env next to this file on the host.
#

# Base domain used to build the app's public URL: APP_URL becomes
# https://resume.${DOMAIN}. Set to valdeze.ch so the app resolves to
# resume.valdeze.ch.
DOMAIN=valdeze.ch

# --- Postgres ---
# Password for the reactive_resume postgres container (POSTGRES_USER/DB
# are hardcoded to "postgres" in docker-compose.yml). Also used to build
# the app's DATABASE_URL connection string -- keep in sync with whatever
# you set here. Plain env var, not a Docker secret, for now.
POSTGRES_PASSWORD=REPLACE_ME

# Signs/encrypts the app's own auth sessions and stored data at rest.
# Generate long random strings for both (e.g. `openssl rand -base64 32`)
# and keep them stable once set -- rotating ENCRYPTION_SECRET in
# particular can make previously encrypted resume data unreadable.
AUTH_SECRET=REPLACE_ME
ENCRYPTION_SECRET=REPLACE_ME

# --- OAuth / OIDC login ---
# OAUTH_PROVIDER_NAME is just the display label shown on the login button.
# OAUTH_CLIENT_ID/SECRET and OAUTH_DISCOVERY_URL point at your identity
# provider's OIDC app registration -- given this homelab's conventions,
# that would normally be Authentik (auth.valdeze.ch), but that's not
# confirmed for this specific stack; check what's actually registered
# before assuming.
#
# IMPORTANT: this stack's ACTIVE reactive_resume service has NO traefik.*
# labels at all in docker-compose.yml (a second, fully-commented-out copy
# of the service further down does have them, but it's disabled). It's
# not confirmed whether Reactive Resume is actually Traefik-routed today --
# don't assume resume.valdeze.ch resolves/works without checking first.
OAUTH_PROVIDER_NAME=REPLACE_ME
OAUTH_CLIENT_ID=REPLACE_ME
OAUTH_CLIENT_SECRET=REPLACE_ME
OAUTH_DISCOVERY_URL=REPLACE_ME

# --- Feature flags ---
# Each is a simple true/false switch read straight from the environment.
# FLAG_DISABLE_SIGNUPS: set true to stop new users from registering.
# FLAG_DISABLE_EMAIL_AUTH: set true to disable classic email/password
#   login (e.g. if you want OAuth/OIDC to be the only way in).
# FLAG_DISABLE_IMAGE_PROCESSING: set true to skip server-side image
#   processing (profile pictures etc.) -- useful if that's causing issues.
# FLAG_DISABLE_API_RATE_LIMIT: set true to turn off the app's built-in API
#   rate limiting.
FLAG_DISABLE_SIGNUPS=REPLACE_ME
FLAG_DISABLE_EMAIL_AUTH=REPLACE_ME
FLAG_DISABLE_IMAGE_PROCESSING=REPLACE_ME
FLAG_DISABLE_API_RATE_LIMIT=REPLACE_ME

# --- S3-compatible storage (for resume exports/assets) ---
# Configured here for MEGA S4 per the inline comment in docker-compose.yml,
# but any S3-compatible provider's credentials work the same way.
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY: your storage credentials.
# S3_BUCKET: the bucket name to store files in.
# S3_REGION: the bucket's region (some S3-compatible providers still
#   require a placeholder value here even if regions aren't really used).
# S3_ENDPOINT: the provider's S3-compatible API endpoint URL.
# S3_FORCE_PATH_STYLE: set true for providers that require path-style
#   bucket URLs (bucket in the path) instead of virtual-hosted-style
#   (bucket in the hostname) -- check your provider's docs if uploads fail.
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
S3_BUCKET=REPLACE_ME
S3_REGION=REPLACE_ME
S3_ENDPOINT=REPLACE_ME
S3_FORCE_PATH_STYLE=REPLACE_ME
