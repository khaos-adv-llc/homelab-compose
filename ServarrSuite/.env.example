# Template only -- lists the variable names this stack's docker-compose.yml
# expects. Real values live in Infisical, never here and never in git.
# scripts/render-env.sh writes the actual .env next to this file on the host.
#

# --- Cross-cutting basics ---
# DOMAIN is used in every Traefik Host() rule in this stack
# (`Host('appname.${DOMAIN:-valdeze.ch}')`), so changing
# it here changes every service's internal hostname at once. It falls back
# to valdeze.ch if unset. Almost everything in this repo now uses this
# single appname.${DOMAIN} hostname, reachable on the LAN directly or
# remotely via the split-tunnel VPN -- Pangolin external exposure is
# now the exception, not the default (see
# valdeze.ch for anything Pangolin-exposed -- nothing in this stack is
# exposed that way today).
#
# PUID/PGID/TZ/UMASK are the standard LinuxServer.io (lscr.io) image
# quartet, reused across most services here via the `env_common` YAML
# anchor (so they're not retyped per-service). PUID/PGID should match a
# real user/group on the host that owns the media files under
# /home/tuckeraa/media, so containers can read/write them without
# permission errors. These four (plus DOMAIN) are cross-cutting
# values several stacks in this repo share -- normally set once as Arcane
# "global Variables" rather than repeated per-stack.
DOMAIN=valdeze.ch
TZ=Europe/Zurich
PUID=1000
PGID=1000
UMASK=002

# --- gluetun (primary VPN gateway) ---
# VPN_SERVICE_PROVIDER/VPN_TYPE: "custom" + "wireguard" here, meaning
#   gluetun connects to your own WireGuard endpoint/keys rather than using
#   one of gluetun's built-in commercial-provider profiles.
# WIREGUARD_PRIVATE_KEY / WIREGUARD_PUBLIC_KEY / WIREGUARD_ADDRESSES /
#   WIREGUARD_ENDPOINT_IP / WIREGUARD_ENDPOINT_PORT: your WireGuard peer
#   config -- private key is yours, public key is the remote endpoint's,
#   addresses is the internal WG IP(s) assigned to you, endpoint IP/port is
#   where that WG server listens.
# DNS_ADDRESS: the DNS resolver gluetun should use inside the tunnel.
# FIREWALL_VPN_INPUT_PORTS: ports allowed IN through the tunnel (the
#   torrenting port) -- also reused directly as the published host port
#   ("${FIREWALL_VPN_INPUT_PORTS}:${FIREWALL_VPN_INPUT_PORTS}") further
#   down in the gluetun service.
# FIREWALL_INPUT_PORTS: ports allowed on gluetun's normal (non-VPN)
#   interface -- needed because qbittorrent's WebUI (8082) is reached via
#   gluetun's own network namespace when qbittorrent is enabled.
# FIREWALL_OUTBOUND_SUBNETS: LAN subnets allowed to reach this container
#   despite the VPN's default "block everything but the tunnel" firewall
#   -- use your actual LAN subnet(s), never a single container IP (Docker
#   IPs rotate; this should be a real LAN/VLAN subnet).
# VPN_PORT_FORWARDING / VPN_PORT_FORWARDING_PROVIDER: whether gluetun asks
#   your VPN provider for a forwarded port, and which provider's port-
#   forwarding API to use (only meaningful for providers that support it).
# HTTPPROXY: exposes gluetun's built-in HTTP proxy so other containers can
#   proxy through it without joining gluetun's network namespace directly.
# HEALTH_VPN_DURATION_INITIAL: how long gluetun's healthcheck grace period
#   lasts before it starts expecting a working tunnel.
VPN_SERVICE_PROVIDER=REPLACE_ME
VPN_TYPE=REPLACE_ME
WIREGUARD_PRIVATE_KEY=REPLACE_ME
WIREGUARD_PUBLIC_KEY=REPLACE_ME
WIREGUARD_ENDPOINT_IP=REPLACE_ME
WIREGUARD_ENDPOINT_PORT=REPLACE_ME
WIREGUARD_ADDRESSES=REPLACE_ME
DNS_ADDRESS=REPLACE_ME
FIREWALL_VPN_INPUT_PORTS=REPLACE_ME
FIREWALL_INPUT_PORTS=REPLACE_ME
FIREWALL_OUTBOUND_SUBNETS=REPLACE_ME
VPN_PORT_FORWARDING=REPLACE_ME
VPN_PORT_FORWARDING_PROVIDER=REPLACE_ME
HTTPPROXY=REPLACE_ME
HEALTH_VPN_DURATION_INITIAL=REPLACE_ME

# --- gluetun-proton (second, independent VPN gateway) ---
# A separate WireGuard tunnel specifically to ProtonVPN, used to route
# slskd/Soulseek traffic (network_mode: service:gluetun-proton) apart from
# whatever provider the main gluetun uses above.
# PROTON_WG_PRIVATE_KEY / PROTON_WG_ADDRESSES: your ProtonVPN WireGuard
#   key and assigned internal address(es), from Proton's account dashboard.
# PROTON_SERVER_COUNTRIES: restricts which Proton exit countries gluetun
#   may connect through (e.g. "Switzerland").
PROTON_WG_PRIVATE_KEY=REPLACE_ME
PROTON_WG_ADDRESSES=REPLACE_ME
PROTON_SERVER_COUNTRIES=REPLACE_ME

# --- rclone-webgui ---
# Basic-auth username/password for rclone's own web GUI (--rc-user/
# --rc-pass flags) -- this protects the rclone remote-control daemon's
# UI/API, not a Traefik/Authentik login, so pick a real password here even
# though it's only reachable at rclone.${DOMAIN} today.
RCLONE_USER=REPLACE_ME
RCLONE_PASS=REPLACE_ME

# --- profilarr-v2 OIDC login ---
# Authentik OIDC application credentials for profilarr-v2 (it delegates
# login entirely to Authentik at auth.valdeze.ch rather than using its own
# accounts). PROFILARR_V2_OIDC_URL is the IdP's
# `.well-known/openid-configuration` discovery endpoint;
# PROFILARR_V2_OIDC_ID/SECRET are the client credentials for the OIDC
# application registered in Authentik.
PROFILARR_V2_OIDC_URL=REPLACE_ME
PROFILARR_V2_OIDC_ID=REPLACE_ME
PROFILARR_V2_OIDC_SECRET=REPLACE_ME

# --- Jellystat's dedicated Postgres ---
# Credentials for the jellystat-db postgres container, reused by the
# jellystat app container itself to connect to it (POSTGRES_IP/PORT in
# docker-compose.yml point at jellystat-db:5432, hardcoded). Plain env
# vars for now, not Docker secrets.
JELLYSTAT_POSTGRES_USER=REPLACE_ME
JELLYSTAT_POSTGRES_PASSWORD=REPLACE_ME
# Signs Jellystat's own login sessions -- generate a long random string,
# unrelated to Jellyfin's own auth or to the Postgres credentials above.
JELLYSTAT_JWT_SECRET=REPLACE_ME

# --- Duplicati (config backups for the whole stack) ---
# DUPLICATI_WEBUI_PASSWORD sets the login password for Duplicati's own web
# UI on first start (LinuxServer.io image convention:
# DUPLICATI__WEBSERVICE_PASSWORD). DUPLICATI_SETTINGS_ENCRYPTION_KEY
# encrypts Duplicati's local settings database -- generate a long random
# string and keep it stable, since losing it can make Duplicati's own
# stored backup-job settings (destinations, encryption keys for the
# backups themselves, etc.) unrecoverable. Note: Duplicati backs up every
# *arr/Jellyfin/etc. config volume, not the media library itself (that's
# considered re-downloadable) -- the actual backup job (schedule,
# retention, remote destination) still has to be configured by hand
# through Duplicati's web UI after first start; nothing is scheduled by
# default.
DUPLICATI_WEBUI_PASSWORD=REPLACE_ME
DUPLICATI_SETTINGS_ENCRYPTION_KEY=REPLACE_ME

# --- Optional overrides (have defaults in docker-compose.yml) ---
# These two are referenced with a `:-default` fallback
# (${LOG_LEVEL:-info}, ${SUGGESTARR_PORT:-5000}), so docker-compose.yml
# works fine without them -- only set them if you want to override
# suggestarr's log verbosity or web port. Left commented out/omitted by
# default; uncomment and set a value to override.
#LOG_LEVEL=info
#SUGGESTARR_PORT=5000
