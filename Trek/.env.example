# Template only -- lists the variable names this stack's docker-compose.yml
# expects. Real values live in Infisical, never here and never in git.
# scripts/render-env.sh writes the actual .env next to this file on the host.
#

# Encrypts data Trek stores at rest. Generate a long random string (e.g.
# `openssl rand -hex 32`) and keep it stable once set -- changing it later
# can make previously encrypted data unreadable.
ENCRYPTION_KEY=REPLACE_ME

# Credentials for Trek's own initial admin account. Trek's APP_URL/
# ALLOWED_ORIGINS are hardcoded to trek.external.valdeze.ch (following this
# repo's external naming pattern), and it doesn't appear to use
# Authentik/OIDC here -- it has its own login instead, with
# ADMIN_EMAIL/ADMIN_PASSWORD provisioning the first account. Any valid
# email address and a strong password.
#
# Note: this stack's docker-compose.yml has no traefik.* labels at all,
# even though it's on the shared-services network Traefik also sits on --
# so it's not clear from this repo alone whether routing to Trek is done
# via Traefik's separate file-based (dynamic/) config instead, or whether
# it isn't actually Traefik-routed yet. Worth confirming rather than
# assuming it's reachable at trek.external.valdeze.ch today.
ADMIN_EMAIL=REPLACE_ME
ADMIN_PASSWORD=REPLACE_ME
