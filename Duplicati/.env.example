# Template only -- lists the variable names this stack's docker-compose.yml
# expects. Real values live in Infisical, never here and never in git.
# scripts/render-env.sh writes the actual .env next to this file on the host.

# --- LinuxServer.io common block (previously the x-env-common YAML anchor
# shared with ServarrSuite -- anchors don't work across separate compose
# files, so these are spelled out explicitly here) ---
PUID=1000
PGID=1000
TZ=Europe/Zurich
UMASK=

# Web UI login password for the Duplicati interface, set on first start.
DUPLICATI_WEBUI_PASSWORD=REPLACE_ME

# Encrypts Duplicati's own job/database config at rest.
# Generate with: openssl rand -hex 32
# Losing this after backup jobs exist makes those job configs unrecoverable
# (separate from whatever per-job passphrase protects the backup DATA itself).
DUPLICATI_SETTINGS_ENCRYPTION_KEY=REPLACE_ME
