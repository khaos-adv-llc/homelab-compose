# Template only -- lists the variable names this stack's docker-compose.yml
# expects. Real values live in Infisical, never here and never in git.
# scripts/render-env.sh writes the actual .env next to this file on the host.
#

# Authentik API token for this LDAP outpost -- generated in Authentik's
# admin UI when you create/assign the outpost (Applications > Outposts),
# and distinct from a user's own password. This outpost provides
# LDAP-based auth as a fallback for apps that can't do OIDC natively, and
# is attached to both MediaServer and shared-services so it can serve
# LDAP lookups to services on either network.
AUTHENTIK_TOKEN=REPLACE_ME
