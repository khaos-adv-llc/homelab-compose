# Template only -- lists the variable names this stack's docker-compose.yml
# expects. Real values live in Infisical, never here and never in git.
# scripts/render-env.sh writes the actual .env next to this file on the host.

# --- Authentik's dedicated Postgres database ---
# Used to configure the postgresql container itself, and again by the
# server/worker containers (as AUTHENTIK_POSTGRESQL__USER/__NAME/__PASSWORD)
# and by the postgresql-backup sidecar to connect to that same database.
# Keep all three in sync -- they describe one database from three angles.
# Still plain env vars here rather than Docker secrets files, even though
# this is exactly the kind of credential the central postgres/Infisical
# stacks already keep as file-based secrets -- worth migrating eventually.
#
# The postgresql-backup sidecar (prodrigestivill/postgres-backup-local)
# dumps this database daily, keeping 7 daily / 4 weekly / 6 monthly backups
# under /docker/Authentik/pgdump -- those retention numbers are hardcoded
# in docker-compose.yml, not templated here.
PG_USER=REPLACE_ME
PG_PASS=REPLACE_ME
PG_DB=REPLACE_ME

# Authentik is THE identity provider for this whole homelab -- every
# externally-exposed app defaults to OIDC against it at auth.valdeze.ch
# (its one and only URL; there's no internal-only alias). This key signs
# and encrypts Authentik's own sessions/cookies/tokens: generate a long
# random string (e.g. `openssl rand -base64 60`) and treat losing or
# rotating it as effectively logging out every user and outpost. Used
# identically by both the `server` and `worker` containers -- they must
# share the same value.
AUTHENTIK_SECRET_KEY=REPLACE_ME

# --- Outbound email (used for password resets, notifications, etc.) ---
# Standard SMTP relay settings Authentik uses to send mail. HOST/PORT are
# your mail provider's SMTP endpoint (e.g. smtp.gmail.com / 587).
# USERNAME/PASSWORD are the mailbox credentials to authenticate with.
# USE_TLS vs USE_SSL: set one or the other depending on what your provider
# expects on that port (587 = STARTTLS/USE_TLS, 465 = implicit TLS/USE_SSL)
# -- not both at once. TIMEOUT is in seconds. FROM is the "From:" address
# Authentik's emails will show.
AUTHENTIK_EMAIL__HOST=REPLACE_ME
AUTHENTIK_EMAIL__PORT=REPLACE_ME
AUTHENTIK_EMAIL__USERNAME=REPLACE_ME
AUTHENTIK_EMAIL__PASSWORD=REPLACE_ME
AUTHENTIK_EMAIL__USE_TLS=REPLACE_ME
AUTHENTIK_EMAIL__USE_SSL=REPLACE_ME
AUTHENTIK_EMAIL__TIMEOUT=REPLACE_ME
AUTHENTIK_EMAIL__FROM=REPLACE_ME
