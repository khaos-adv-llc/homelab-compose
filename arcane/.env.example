# Template only -- lists the variable names this stack's docker-compose.yml
# expects. Real values live in Infisical, never here and never in git.
# scripts/render-env.sh writes the actual .env next to this file on the host.
#

# Arcane is the web UI/manager this repo's Git Sync workflow relies on to
# pull compose files and (re)deploy stacks -- so this stack needs to be
# running correctly for everything else to update. It's reachable ONLY at
# arcane.external.valdeze.ch; hitting arcane.internal.valdeze.ch gets you a
# permanent redirect out to the external hostname (see the
# arcane-internal-to-external middleware in docker-compose.yml) rather than
# being served directly -- that's intentional, not a bug, so don't "fix" it
# by adding real internal routing without checking with Tucker first.
#
# Note: Arcane mounts the real Docker socket directly
# (/var/run/docker.sock, not socket-proxy) -- this is one of the known,
# not-yet-hardened spots in this homelab's Docker-socket exposure (Traefik
# is the only thing that goes through socket-proxy today).

# Full connection string for Arcane's own database, e.g.
# postgres://<user>:<password>@postgres:5432/<dbname> -- points at the
# shared central `postgres` stack (see the postgres stack's own
# arcane_pg_pw.txt secret for that side of the credential). This is a
# plain env var here rather than a Docker secret, even though the DB
# password portion of it is sensitive -- worth migrating to a secrets file
# eventually, consistent with the postgres stack's own pattern.
ARCANE_DATABASE_URL=REPLACE_ME

# Used to encrypt sensitive data Arcane stores at rest (e.g. things like
# registry credentials). Generate a long random string and keep it stable
# once set -- rotating it can make previously encrypted data unreadable.
ARCANE_ENCRYPTION_KEY=REPLACE_ME

# Signs Arcane's own login session tokens. Any long random string; treat it
# like a password and don't reuse it elsewhere.
ARCANE_JWT_SECRET=REPLACE_ME
