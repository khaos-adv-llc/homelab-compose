# Template only -- lists the variable names this stack's docker-compose.yml
# expects. Real values live in Infisical, never here and never in git.
# scripts/render-env.sh writes the actual .env next to this file on the host.
#
# There is ONE control surface (panel/), at ONE public URL
# (fluxerbridge.valdeze.ch, via Pangolin). Everyone logs in with Discord or
# Fluxer OAuth2; "admin" isn't a separate role or group here -- it's
# answered live, per guild, by asking that platform's bot whether your
# logged-in identity actually administers the guild in question. See
# README.md for the full design and the manual Discord Developer Portal /
# Fluxer application / Pangolin setup steps this stack needs beyond what's
# in this file.

# --- Bridge legs (used by discord-leg / fluxer-leg) ---

# A Discord bot application's token (Discord Developer Portal -> your
# application -> Bot -> Reset Token). This must be a real registered BOT
# account, never a user account automated in its place -- see the build
# spec doc's "explicitly out of scope" section for why: automating a
# Discord user account violates Discord's ToS regardless of server-admin
# consent, and this project deliberately does not do that.
# Invite this bot into every Discord guild you want selectable, with
# CONNECT + SPEAK in whichever voice channels should be joinable, and
# enough to read guild members (needed for the live admin checks below).
DISCORD_BOT_TOKEN=REPLACE_ME

# Base URL of the Fluxer instance to connect to (e.g. https://fluxer.app
# for the hosted instance, or your own self-hosted instance's URL). Both
# fluxer-leg and panel read GET <this>/.well-known/fluxer to discover the
# real API/gateway/OAuth endpoints -- never hardcode those separately.
FLUXER_INSTANCE_URL=https://fluxer.app

# A Fluxer bot application's token (format per Fluxer's docs:
# <application_id>.<secret>). Bots are exempt from Fluxer's E2EE-required
# voice check, which is convenient here. Authorize this bot into every
# Fluxer guild you want selectable, with the same permissions as the
# Discord bot above.
FLUXER_BOT_TOKEN=REPLACE_ME

# --- panel: OAuth + session ---

# Signs the panel's login session cookie. Generate with e.g.
# `openssl rand -hex 32`. Rotating this logs everyone out; it protects
# against a forged session cookie, nothing else -- no platform tokens are
# ever stored (see panel/db.js), so a forged cookie only grants whatever
# the live admin check would grant anyway.
USER_PANEL_SESSION_SECRET=REPLACE_ME

# A Discord OAuth2 application's Client ID + Secret (Discord Developer
# Portal -> your application -> OAuth2). This can be the SAME Discord
# application as the bot above (an application has both a bot user and an
# OAuth2 client), or a separate one -- either works, but its OAuth2
# redirect URI must include
# https://fluxerbridge.valdeze.ch/auth/discord/callback
# (see PUBLIC_BASE_URL in docker-compose.yml).
DISCORD_OAUTH_CLIENT_ID=REPLACE_ME
DISCORD_OAUTH_CLIENT_SECRET=REPLACE_ME

# A Fluxer OAuth2 application's Client ID + Secret (per
# docs.fluxer.app/http-api/oauth2/) -- same application-vs-bot flexibility
# as Discord above. Its registered redirect URI must include
# https://fluxerbridge.valdeze.ch/auth/fluxer/callback
FLUXER_OAUTH_CLIENT_ID=REPLACE_ME
FLUXER_OAUTH_CLIENT_SECRET=REPLACE_ME

# --- Not stored in Infisical / not in this file ---
# Internal UDP relay ports/hosts, each service's control-API port, the
# panel's own listen port and DB path, PUBLIC_BASE_URL,
# DISCONNECT_COOLDOWN_SECONDS, and HANDOFF_TOKEN_TTL_HOURS are all set
# directly in docker-compose.yml, not here -- they're wiring/policy for
# this stack's own containers, not secrets or per-deployment config.
